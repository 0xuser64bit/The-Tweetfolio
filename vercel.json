{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "build",
  "trailingSlash": false,
  "routes": [
    {
      "src": "^/$",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": { "re": ".*(text/markdown|application/json|text/plain).*" }
        }
      ],
      "dest": "/api/page?__path=/"
    },
    {
      "src": "^/proof-of-work$",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": { "re": ".*(text/markdown|application/json|text/plain).*" }
        }
      ],
      "dest": "/api/page?__path=/proof-of-work"
    },
    {
      "src": "^/$",
      "has": [{ "type": "header", "key": "accept" }],
      "missing": [
        {
          "type": "header",
          "key": "accept",
          "value": {
            "re": ".*(text/html|text/markdown|text/plain|application/json|text/\\*|\\*/\\*).*"
          }
        }
      ],
      "dest": "/api/page?__path=/"
    },
    {
      "src": "^/proof-of-work$",
      "has": [{ "type": "header", "key": "accept" }],
      "missing": [
        {
          "type": "header",
          "key": "accept",
          "value": {
            "re": ".*(text/html|text/markdown|text/plain|application/json|text/\\*|\\*/\\*).*"
          }
        }
      ],
      "dest": "/api/page?__path=/proof-of-work"
    }
  ],
  "rewrites": [
    {
      "source": "/api/v1/:resource",
      "destination": "/api/v1?__resource=:resource"
    },
    {
      "source": "/api/v1/:resource/:id",
      "destination": "/api/v1?__resource=:resource&__id=:id"
    },
    { "source": "/api/:path*", "destination": "/api/v1?__path=:path*" },
    { "source": "/:path*", "destination": "/api/not-found?__path=:path*" }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Vary", "value": "Accept, Accept-Encoding" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        {
          "key": "Link",
          "value": "</index.md>; rel=\"alternate\"; type=\"text/markdown\", </llms.txt>; rel=\"alternate\"; type=\"text/plain\", </openapi.json>; rel=\"service-desc\"; type=\"application/json\""
        }
      ]
    },
    {
      "source": "/proof-of-work",
      "headers": [
        { "key": "Vary", "value": "Accept, Accept-Encoding" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        {
          "key": "Link",
          "value": "</proof-of-work.md>; rel=\"alternate\"; type=\"text/markdown\", </llms.txt>; rel=\"alternate\"; type=\"text/plain\", </openapi.json>; rel=\"service-desc\"; type=\"application/json\""
        }
      ]
    },
    {
      "source": "/index.md",
      "headers": [
        { "key": "Content-Type", "value": "text/markdown; charset=utf-8" },
        { "key": "Vary", "value": "Accept, Accept-Encoding" },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=3600, stale-while-revalidate=86400"
        },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/proof-of-work.md",
      "headers": [
        { "key": "Content-Type", "value": "text/markdown; charset=utf-8" },
        { "key": "Vary", "value": "Accept, Accept-Encoding" },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=3600, stale-while-revalidate=86400"
        },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=3600, stale-while-revalidate=86400"
        },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/llms-full.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=3600, stale-while-revalidate=86400"
        },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/openapi.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=3600, stale-while-revalidate=86400"
        },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "functions": {
    "api/not-found.ts": { "runtime": "edge" },
    "api/page.ts": { "runtime": "edge" },
    "api/v1.ts": { "runtime": "edge" }
  }
}
